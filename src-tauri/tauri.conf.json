{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TechnoAfandi-FC",
  "version": "1.2.20",
  "identifier": "com.technoafandi.fc26tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TechnoAfandi - FC",
        "url": "home_page_v2.html",
        "width": 500,
        "height": 760,
        "minWidth": 460,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lilmoneam44/TechnoAfandi/releases/latest/download/latest.json"
      ]
    }
  }
}
